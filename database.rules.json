{
  "rules": {
    "accounts": {
      "$key": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name','salt','hash','uid','iters']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "$peer": {
          ".write": "auth != null && (!data.exists() || data.child('u').val() === auth.uid)",
          ".validate": "newData.hasChildren(['u','t','p']) && newData.child('u').val() === auth.uid"
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$peer": {
        ".write": "auth != null && (!data.exists() || data.child('u').val() === auth.uid)",
        ".validate": "newData.hasChildren(['u','t','p']) && newData.child('u').val() === auth.uid"
      }
    }
  }
}
